PORT=3001
CORS_ORIGIN=http://localhost:5173

# Absolute or relative path to a folder of local/synced photos
PHOTOS_DIR=./photos

# Round to the nearest useful precision for your location
WEATHER_LAT=0
WEATHER_LON=0

# From https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify no longer allows "localhost" - use 127.0.0.1 instead
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/spotify/callback

TOKEN_STORE_PATH=./data/spotify-tokens.json
